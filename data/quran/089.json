{"n":89,"name":"الفجر","verses":[{"v":1,"ar":"وَٱلۡفَجۡرِ","he":"חי השחר,","topics":null,"story":null,"notes":null,"hadith":null},{"v":2,"ar":"وَلَيَالٍ عَشۡرٖ","he":"ולילות עשרה,","topics":null,"story":null,"notes":["״לילות עשרה״ – לפי רוב המפרשים: עשרת ימי ד׳ו אל־חִגַּ׳ה הראשונים; יש שקשרו לעשרת ימי תשובה."],"hadith":null},{"v":3,"ar":"وَٱلشَّفۡعِ وَٱلۡوَتۡرِ","he":"והזוג והיחיד,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَٱلَّيۡلِ إِذَا يَسۡرِ","he":"והלילה כאשר הוא חולף –","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"هَلۡ فِي ذَٰلِكَ قَسَمٞ لِّذِي حِجۡرٍ","he":"האם יש בזה שבועה לבעל בינה?","topics":"שבועות, נדרים וקיום ברית","story":null,"notes":null,"hadith":null},{"v":6,"ar":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِعَادٍ","he":"הלא ראית מה עשה ריבונך לעאד –","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":7,"ar":"إِرَمَ ذَاتِ ٱلۡعِمَادِ","he":"אִרַם בעלת העמודים,","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":["אִרַם בעלת העמודים – עיר אגדית של עאד; בעברית ״ארם״ מקראית שונה. השם נשמר בתעתיק."],"hadith":null},{"v":8,"ar":"ٱلَّتِي لَمۡ يُخۡلَقۡ مِثۡلُهَا فِي ٱلۡبِلَٰدِ","he":"אשר לא נבראה כמותה בארצות;","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":9,"ar":"وَثَمُودَ ٱلَّذِينَ جَابُواْ ٱلصَّخۡرَ بِٱلۡوَادِ","he":"ולתמוד, אשר חצבו את הסלע בעמק;","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَفِرۡعَوۡنَ ذِي ٱلۡأَوۡتَادِ","he":"ולפרעה בעל היתדות –","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":11,"ar":"ٱلَّذِينَ طَغَوۡاْ فِي ٱلۡبِلَٰدِ","he":"אשר זדו בארצות,","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":12,"ar":"فَأَكۡثَرُواْ فِيهَا ٱلۡفَسَادَ","he":"והרבו בהן השחתה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"فَصَبَّ عَلَيۡهِمۡ رَبُّكَ سَوۡطَ عَذَابٍ","he":"ושפך עליהם ריבונך שוט עונש.","topics":null,"story":null,"notes":null,"hadith":null},{"v":14,"ar":"إِنَّ رَبَّكَ لَبِٱلۡمِرۡصَادِ","he":"ריבונך – במארב (צופה).","topics":null,"story":null,"notes":null,"hadith":null},{"v":15,"ar":"فَأَمَّا ٱلۡإِنسَٰنُ إِذَا مَا ٱبۡتَلَىٰهُ رَبُّهُۥ فَأَكۡرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيٓ أَكۡرَمَنِ","he":"ואשר לאדם – כאשר ריבונו בוחן אותו, ומכבד אותו ומענג אותו – אומר: ״ריבוני כיבדני״;","topics":"הודיה והכרת טובה","story":null,"notes":null,"hadith":null},{"v":16,"ar":"وَأَمَّآ إِذَا مَا ٱبۡتَلَىٰهُ فَقَدَرَ عَلَيۡهِ رِزۡقَهُۥ فَيَقُولُ رَبِّيٓ أَهَٰنَنِ","he":"ואשר כאשר הוא בוחן אותו ומצמצם עליו את פרנסתו – אומר: ״ריבוני השפילני״.","topics":"השגחה, פרנסה וגזרה","story":null,"notes":null,"hadith":null},{"v":17,"ar":"كَلَّاۖ بَل لَّا تُكۡرِمُونَ ٱلۡيَتِيمَ","he":"לא! אינכם מכבדים את היתום,","topics":"יתומים, עניים וחלשים","story":null,"notes":null,"hadith":null},{"v":18,"ar":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","he":"ואינכם מעוררים זה את זה להאכיל את העני,","topics":"צדקה וזכאת · יתומים, עניים וחלשים","story":null,"notes":null,"hadith":null},{"v":19,"ar":"وَتَأۡكُلُونَ ٱلتُّرَاثَ أَكۡلٗا لَّمّٗا","he":"ואוכלים את הירושה אכילה גרגרנית,","topics":"יתומים, עניים וחלשים · ירושה וצוואה","story":null,"notes":null,"hadith":null},{"v":20,"ar":"وَتُحِبُّونَ ٱلۡمَالَ حُبّٗا جَمّٗا","he":"ואוהבים את הממון אהבה רבה.","topics":"יתומים, עניים וחלשים","story":null,"notes":null,"hadith":null},{"v":21,"ar":"كَلَّآۖ إِذَا دُكَّتِ ٱلۡأَرۡضُ دَكّٗا دَكّٗا","he":"לא! כאשר תוכתש הארץ כתישה אחר כתישה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":22,"ar":"وَجَآءَ رَبُّكَ وَٱلۡمَلَكُ صَفّٗا صَفّٗا","he":"ויבוא ריבונך, והמלאכים שורה אחר שורה,","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":23,"ar":"وَجِاْيٓءَ يَوۡمَئِذِۭ بِجَهَنَّمَۚ يَوۡمَئِذٖ يَتَذَكَّرُ ٱلۡإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكۡرَىٰ","he":"ויובא ביום ההוא הגיהינום – ביום ההוא ייזכר האדם; ואיך תועיל לו התזכורת?","topics":"יום הדין ותחיית המתים · גיהנום","story":null,"notes":null,"hadith":null},{"v":24,"ar":"يَقُولُ يَٰلَيۡتَنِي قَدَّمۡتُ لِحَيَاتِي","he":"יאמר: ״הלוואי שהקדמתי (טוב) לחיי!״","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":25,"ar":"فَيَوۡمَئِذٖ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٞ","he":"ביום ההוא לא יעניש איש כעונשו,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":"1"},{"v":26,"ar":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٞ","he":"ולא יכבול איש ככבילתו.","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":"1"},{"v":27,"ar":"يَـٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ","he":"הוי הנפש השלווה,","topics":null,"story":null,"notes":["אל־נַּפְס אל־מֻטְמַאִנַּה – ״הנפש השלווה״: הדרגה העליונה בתורת הנפש (השוו 75:2, 12:53)."],"hadith":null},{"v":28,"ar":"ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةٗ مَّرۡضِيَّةٗ","he":"שובי אל ריבונך – מרוצה ורצויה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":29,"ar":"فَٱدۡخُلِي فِي عِبَٰدِي","he":"והיכנסי בין עבדיי,","topics":"גן העדן","story":null,"notes":null,"hadith":null},{"v":30,"ar":"وَٱدۡخُلِي جَنَّتِي","he":"והיכנסי לגני.","topics":"גן העדן","story":null,"notes":null,"hadith":null}],"parallels":[{"id":"V191","a":17,"b":20,"corpus":"תנ״ך","ref":"שמות כב, כא","refAr":"الخروج 22: 21","note":"אינכם מכבדים את היתום.","noteAr":"لا تكرمون اليتيم.","srcHe":"כׇּל־אַלְמָנָה וְיָתוֹם לֹא תְעַנּוּן׃","srcAr":"لَا تُسِيءْ إِلَى أَرْمَلَةٍ مَّا وَلَا يَتِيمٍ.","context":null,"strength":"נושאית","topic":"יתומים, עניים וחלשים"},{"id":"V191","a":17,"b":20,"corpus":"תנ״ך","ref":"דברים כד, יז","refAr":"التثنية 24: 17","note":"אינכם מכבדים את היתום.","noteAr":"لا تكرمون اليتيم.","srcHe":"לֹא תַטֶּה מִשְׁפַּט גֵּר יָתוֹם וְלֹא תַחֲבֹל בֶּגֶד אַלְמָנָה׃","srcAr":"«لَا تُعَوِّجْ حُكْمَ ٱلْغَرِيبِ وَٱلْيَتِيمِ، وَلَا تَسْتَرْهِنْ ثَوْبَ ٱلْأَرْمَلَةِ.","context":null,"strength":"נושאית","topic":"יתומים, עניים וחלשים"}],"bible":[{"a":1,"b":2,"ref":"ויקרא כג, כד–כה","route":"b/31/23:24","note":"ראש השנה (״זיכרון תרועה״) הפותח את עשרת ימי התשובה