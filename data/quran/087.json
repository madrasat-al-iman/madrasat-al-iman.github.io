{"n":87,"name":"الأعلى","verses":[{"v":1,"ar":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","he":"שבח את שם ריבונך העליון,","topics":"תפילה וזכירת האל","story":null,"notes":null,"hadith":"58"},{"v":2,"ar":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","he":"אשר ברא ושיווה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","he":"ואשר קבע מידה והדריך,","topics":"הדרכה ותעייה; בחירה ואחריות","story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","he":"ואשר הוציא את המרעה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","he":"ועשה אותו גבבה כהה.","topics":null,"story":null,"notes":null,"hadith":null},{"v":6,"ar":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","he":"נקריא לך, ולא תשכח –","topics":"הנביא מוחמד והקהילה בזמנו","story":null,"notes":null,"hadith":null},{"v":7,"ar":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","he":"מלבד מה שירצה אללה; הוא יודע את הגלוי ואת הנסתר.","topics":null,"story":null,"notes":["״מלבד מה שירצה אללה״ – מקור לדוקטרינת השכחה האלוהית/הנסח׳."],"hadith":null},{"v":8,"ar":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","he":"ונקל עליך (את הדרך) אל הקלה.","topics":null,"story":null,"notes":null,"hadith":null},{"v":9,"ar":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","he":"הזכר אפוא, אם תועיל התזכורת.","topics":null,"story":null,"notes":null,"hadith":null},{"v":10,"ar":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","he":"ייזכר מי שירא,","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":11,"ar":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","he":"ויתרחק ממנה האומלל,","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":12,"ar":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","he":"אשר יישרף באש הגדולה,","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":13,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","he":"ואחר כך לא ימות בה ולא יחיה.","topics":"ישו, מרים, זכריה ויוחנן","story":null,"notes":null,"hadith":null},{"v":14,"ar":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","he":"כבר הצליח מי שהיטהר,","topics":null,"story":null,"notes":null,"hadith":null},{"v":15,"ar":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","he":"וזכר את שם ריבונו והתפלל.","topics":null,"story":null,"notes":null,"hadith":null},{"v":16,"ar":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","he":"אלא שאתם מעדיפים את חיי העולם הזה,","topics":"מוות וחלוף העולם הזה","story":null,"notes":null,"hadith":null},{"v":17,"ar":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","he":"והעולם הבא טוב יותר ומתמיד יותר.","topics":null,"story":null,"notes":null,"hadith":null},{"v":18,"ar":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","he":"זה כתוב במגילות הראשונות,","topics":null,"story":null,"notes":null,"hadith":null},{"v":19,"ar":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","he":"מגילות אברהם ומשה.","topics":"הקוראן והכתבים","story":null,"notes":["מגילות אברהים ומוסא (צֻחֻף) – השוו 53:36–37; מסורת על ״ספר אברהם״ (ספר יצירה מיוחס לאברהם; צוואת אברהם). מקבילה מובהקת."],"hadith":null}],"parallels":[],"bible":[{"a":1,"b":1,"ref":"דברים לב, ג","route":"b/53/32:3","note":"״כי שם ה׳ אקרא הבו גודל לאלוהינו״ (ברכות כא ע״א: מקור ברכת התורה לפני הלימוד!) — פתיחת כל דיבור בשם האל ובגדולתו (בסם אללה / סבח אסם רבכ אלאעלא, 1:1; 87:1; אללה אכבר).","strength":"מובהקת"}]}