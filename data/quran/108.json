{"n":108,"name":"الكوثر","verses":[{"v":1,"ar":"إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ","he":"נתנו לך את השפע (אל־כַּוְת׳ר);","topics":"הנביא מוחמד והקהילה בזמנו","story":null,"notes":["אל־כַּוְת׳ר – ״השפע הרב״, ולפי המסורת נהר בגן העדן; הסורה הקצרה ביותר."],"hadith":null},{"v":2,"ar":"فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ","he":"התפלל אפוא לריבונך ושחט (קורבן).","topics":"קרבנות ומנחות","story":null,"notes":null,"hadith":null},{"v":3,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ","he":"שונאך – הוא הגדוע.","topics":null,"story":null,"notes":["אל־אַבְּתַר – ״הגדוע (ללא צאצאים)״; לפי המסורת: תשובה למי שלעגו לנביא על מות בניו."],"hadith":"2"}],"parallels":[],"bible":[]}