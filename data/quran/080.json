{"n":80,"name":"عبس","verses":[{"v":1,"ar":"عَبَسَ وَتَوَلَّىٰٓ","he":"הזעיף פניו ופנה עורף,","topics":null,"story":null,"notes":["עַבַּסַ – ״הזעיף פניו״: לפי המסורת הנביא פנה מעבדאללה בן אֻמּ מַכְתוּם העיוור אל נכבדי קורייש; תוכחה לנביא עצמו."],"hadith":null},{"v":2,"ar":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","he":"משום שבא אליו העיוור.","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","he":"ומה יודיעך – אולי הוא יטהר,","topics":"הנביא מוחמד והקהילה בזמנו · טהרה","story":null,"notes":null,"hadith":null},{"v":4,"ar":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","he":"או ייזכר, ותועיל לו התזכורת?","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","he":"אשר למי שאינו נזקק –","topics":null,"story":null,"notes":null,"hadith":null},{"v":6,"ar":"فَأَنتَ لَهُۥ تَصَدَّىٰ","he":"אתה פונה אליו;","topics":null,"story":null,"notes":null,"hadith":null},{"v":7,"ar":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","he":"ואין עליך (אשמה) אם לא יטהר.","topics":"טהרה","story":null,"notes":null,"hadith":null},{"v":8,"ar":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","he":"ואשר למי שבא אליך ממהר,","topics":"ידע, תבונה והתבוננות","story":null,"notes":null,"hadith":"1"},{"v":9,"ar":"وَهُوَ يَخۡشَىٰ","he":"והוא ירא –","topics":null,"story":null,"notes":null,"hadith":null},{"v":10,"ar":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","he":"אתה מוסח ממנו.","topics":null,"story":null,"notes":null,"hadith":null},{"v":11,"ar":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","he":"לא! זו תזכורת;","topics":null,"story":null,"notes":null,"hadith":null},{"v":12,"ar":"فَمَن شَآءَ ذَكَرَهُۥ","he":"ומי שרוצה – יזכור אותה,","topics":"הדרכה ותעייה; בחירה ואחריות","story":null,"notes":null,"hadith":null},{"v":13,"ar":"فِي صُحُفٖ مُّكَرَّمَةٖ","he":"במגילות מכובדות,","topics":null,"story":null,"notes":null,"hadith":null},{"v":14,"ar":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","he":"מורמות, מטוהרות,","topics":"טהרה","story":null,"notes":null,"hadith":null},{"v":15,"ar":"بِأَيۡدِي سَفَرَةٖ","he":"ביד