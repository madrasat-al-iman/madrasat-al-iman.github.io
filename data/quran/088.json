{"n":88,"name":"الغاشية","verses":[{"v":1,"ar":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","he":"הלא בא אליך סיפור המכסה (אל־גַאשִׁיַה)?","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":2,"ar":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","he":"פנים ביום ההוא – מושפלות,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":3,"ar":"عَامِلَةٞ نَّاصِبَةٞ","he":"עמלות, יגעות,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":4,"ar":"تَصۡلَىٰ نَارًا حَامِيَةٗ","he":"נשרפות באש לוהטת,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":5,"ar":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","he":"מושקות ממעיין רותח;","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":6,"ar":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","he":"אין להם מאכל אלא מקוצים (צַ׳רִיע),","topics":"יום הדין ותחיית המתים","story":null,"notes":["צַ׳רִיע – צמח קוצני מר (״שִׁבְרִק״)."],"hadith":null},{"v":7,"ar":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","he":"שאינו משמין ואינו משביע רעב.","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":"1"},{"v":8,"ar":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","he":"פנים ביום ההוא – נעימות,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":9,"ar":"لِّسَعۡيِهَا رَاضِيَةٞ","he":"מרוצות משאיפתן,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":10,"ar":"فِي جَنَّةٍ عَالِيَةٖ","he":"בגן רם,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":11,"ar":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","he":"לא תשמע בו דבר הבל;","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":12,"ar":"فِيهَا عَيۡنٞ جَارِيَةٞ","he":"בו מעיין זורם,","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"فِيهَا سُرُرٞ مَّرۡفُوعَةٞ","he":"בו מיטות מורמות,","topics":null,"story":null,"notes":null,"hadith":null},{"v":14,"ar":"وَأَكۡوَابٞ مَّوۡضُوعَةٞ","he":"וגביעים ערוכים,","topics":null,"story":null,"notes":null,"hadith":null},{"v":15,"ar":"وَنَمَارِقُ مَصۡفُوفَةٞ","he":"וכרים מסודרים בשורה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":16,"ar":"وَزَرَابِيُّ مَبۡثُوثَةٌ","he":"ושטיחים פרושים.","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":17,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ","he":"הלא יביטו בגמלים – כיצד נבראו?","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":18,"ar":"وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ","he":"ובשמיים – כיצד הורמו?","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":19,"ar":"وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ","he":"ובהרים – כיצד הוצבו?","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":20,"ar":"وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ","he":"ובארץ – כיצד שוטחה?","topics":null,"story":null,"notes":null,"hadith":null},{"v":21,"ar":"فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرٞ","he":"הזכר אפוא – אתה רק מזכיר;","topics":"הנביא מוחמד והקהילה בזמנו","story":null,"notes":null,"hadith":null},{"v":22,"ar":"لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ","he":"אינך עליהם שליט;","topics":null,"story":null,"notes":null,"hadith":null},{"v":23,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","he":"אבל מי שפנה עורף וכפר –","topics":null,"story":null,"notes":null,"hadith":null},{"v":24,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ","he":"יענישהו אללה את העונש הגדול.","topics":null,"story":null,"notes":null,"hadith":null},{"v":25,"ar":"إِنَّ إِلَيۡنَآ إِيَابَهُمۡ","he":"אלינו שיבתם,","topics":null,"story":null,"notes":null,"hadith":null},{"v":26,"ar":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","he":"ואחר כך עלינו חשבונם.","topics":null,"story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}