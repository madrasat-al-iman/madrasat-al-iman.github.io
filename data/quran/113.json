{"n":113,"name":"الفلق","verses":[{"v":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","he":"אמור: ״אני מבקש מחסה בריבון השחר,","topics":null,"story":null,"notes":null,"hadith":"18"},{"v":2,"ar":"مِن شَرِّ مَا خَلَقَ","he":"מרעת מה שברא,","topics":null,"story":null,"notes":null,"hadith":"13"},{"v":3,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","he":"ומרעת חשכה כאשר היא יורדת,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَمِن شَرِّ ٱلنَّفَّـٰثَٰتِ فِي ٱلۡعُقَدِ","he":"ומרעת הנושפות בקשרים,","topics":null,"story":null,"notes":["אל־נַּפַּאת׳את פי אל־עֻקַד – ״הנושפות בקשרים״: מכשפות; השוו ״קושר חבר״ (דברים יח, יא)."],"hadith":"1"},{"v":5,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","he":"ומרעת מקנא כאשר הוא מקנא.״","topics":null,"story":null,"notes":null,"hadith":"2"}],"parallels":[],"bible":[]}