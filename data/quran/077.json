{"n":77,"name":"المرسلات","verses":[{"v":1,"ar":"وَٱلۡمُرۡسَلَٰتِ عُرۡفٗا","he":"חי השלוחות ברצף (או: בטוב),","topics":"בריאה ואותות הטבע","story":null,"notes":["אל־מֻרְסַלַאת – ״השלוחות״: הרוחות או המלאכים; שבועות כפולות בפתיחה."],"hadith":null},{"v":2,"ar":"فَٱلۡعَٰصِفَٰتِ عَصۡفٗا","he":"והסוערות סערה,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":3,"ar":"وَٱلنَّـٰشِرَٰتِ نَشۡرٗا","he":"והפורשות פרישה,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":4,"ar":"فَٱلۡفَٰرِقَٰتِ فَرۡقٗا","he":"והמבדילות הבדלה,","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":5,"ar":"فَٱلۡمُلۡقِيَٰتِ ذِكۡرًا","he":"והמשליכות תזכורת –","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":6,"ar":"عُذۡرًا أَوۡ نُذۡرًا","he":"הצדקה או אזהרה –","topics":null,"story":null,"notes":null,"hadith":null},{"v":7,"ar":"إِنَّمَا تُوعَدُونَ لَوَٰقِعٞ","he":"מה שמובטח לכם – בוא יבוא.","topics":null,"story":null,"notes":null,"hadith":null},{"v":8,"ar":"فَإِذَا ٱلنُّجُومُ طُمِسَتۡ","he":"וכאשר הכוכבים יכבו,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":9,"ar":"وَإِذَا ٱلسَّمَآءُ فُرِجَتۡ","he":"וכאשר השמיים ייפרצו,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَإِذَا ٱلۡجِبَالُ نُسِفَتۡ","he":"וכאשר ההרים ייעקרו,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":11,"ar":"وَإِذَا ٱلرُّسُلُ أُقِّتَتۡ","he":"וכאשר לשליחים ייקבע מועד –","topics":"נבואה ושליחות","story":null,"notes":null,"hadith":null},{"v":12,"ar":"لِأَيِّ يَوۡمٍ أُجِّلَتۡ","he":"לאיזה יום נדחו?","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"لِيَوۡمِ ٱلۡفَصۡلِ","he":"ליום ההכרעה.","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":14,"ar":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلۡفَصۡلِ","he":"ומה יודיעך מה הוא יום ההכרעה?","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v"