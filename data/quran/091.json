{"n":91,"name":"الشمس","verses":[{"v":1,"ar":"وَٱلشَّمۡسِ وَضُحَىٰهَا","he":"חי השמש וזוהרה,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":2,"ar":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","he":"והירח כאשר הוא בא אחריה,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":3,"ar":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","he":"והיום כאשר הוא מגלה אותה,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","he":"והלילה כאשר הוא מכסה אותה,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":5,"ar":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","he":"והשמיים ומי שבנה אותם,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":6,"ar":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","he":"והארץ ומי שפרש אותה,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":7,"ar":"وَنَفۡسٖ وَمَا سَوَّىٰهَا","he":"ונפש ומי ששיווה אותה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":8,"ar":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","he":"והשרה בה את פריצותה ואת יראתה –","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":["פֻגּ׳וּר ותַקְוַא – ״פריצותה ויראתה״: שני היצרים בנפש; השוו יצר הטוב ויצר הרע (ברכות סא ע״א)."],"hadith":null},{"v":9,"ar":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","he":"כבר הצליח מי שטיהר אותה,","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","he":"וכבר נכשל מי שקבר אותה (בחטא).","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":["דַסַּא – ״קבר/הסתיר/הנמיך״: ההפך מ״טיהר/גידל״ (זַכַּא)."],"hadith":null},{"v":11,"ar":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","he":"הכחישה תמוד בזדונה,","topics":"הכחשת השליחים וחורבן העמים","story":null,"notes":null,"hadith":null},{"v":12,"ar":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","he":"כאשר קם האומלל שבהם;","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","he":"ואמר להם שליח אללה: ״(שמרו על) נאקת אללה ועל שתייתה!״","topics":"הנביא מוחמד והקהילה בזמנו","story":null,"notes":null,"hadith":"8"},{"v":14,"ar":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","he":"והכחישו אותו, ועקרו אותה; והשמיד אותם ריבונם בשל חטאם, והשווה אותה (את העונש על כולם);","topics":null,"story":null,"notes":null,"hadith":null},{"v":15,"ar":"وَلَا يَخَافُ عُقۡبَٰهَا","he":"ואינו ירא את תוצאותיה.","topics":null,"story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[{"a":8,"b":8,"ref":"דברים ל, טו","route":"b/51/30:15","note":"״ראה נתתי לפניך היום את החיים ואת הטוב ואת המוות ואת הרע״ — הכרזת הבחירה החופשית המפורסמת ביותר בתורה, מקבילה ישירות לשלושה פסוקי מופת בקוראן: ״הדרכנו אותו בדרך – אם מודה ואם כופר״ (76:3), ״והורינו לו את שתי הדרכים״ (90:10), ו״והשראה לה את חטאה ואת יראתה״ (91:8)!","strength":"מובהקת"}]}