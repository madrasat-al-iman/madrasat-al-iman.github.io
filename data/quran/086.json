{"n":86,"name":"الطارق","verses":[{"v":1,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","he":"חי השמיים והבא בלילה (אל־טַּארִק)!","topics":null,"story":null,"notes":["אל־טַּארִק – ״הבא בלילה/הדופק״: הכוכב הנוקב (השוו ״כוכב השחר״)."],"hadith":null},{"v":2,"ar":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","he":"ומה יודיעך מה הוא הבא בלילה?","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"ٱلنَّجۡمُ ٱلثَّاقِبُ","he":"הכוכב הנוקב.","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ","he":"אין נפש שאין עליה שומר.","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","he":"יביט אפוא האדם ממה נברא:","topics":null,"story":null,"notes":null,"hadith":null},{"v":6,"ar":"خُلِقَ مِن مَّآءٖ دَافِقٖ","he":"נברא ממים ניתזים,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":7,"ar":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","he":"היוצאים מבין עמוד השדרה ועצמות החזה.","topics":"יום הדין ותחיית המתים","story":null,"notes":["״מבין עמוד השדרה ועצמות החזה״ – תיאור קדום של מקור הזרע; מחלוקת בין המפרשים."],"hadith":null},{"v":8,"ar":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ","he":"הוא יכול להשיבו,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":9,"ar":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","he":"ביום שבו ייבחנו הסודות,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":10,"ar":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ","he":"ולא יהיה לו כוח ולא עוזר.","topics":null,"story":null,"notes":null,"hadith":null},{"v":11,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","he":"חי השמיים בעלי השיבה (הגשם),","topics":null,"story":null,"notes":null,"hadith":null},{"v":12,"ar":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","he":"והארץ בעלת הבקיעה (הצמחים) –","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"إِنَّهُۥ لَقَوۡلٞ فَصۡلٞ","he":"זה דבר מכריע,","topics":"הקוראן והכתבים","story":null,"notes":null,"hadith":null},{"v":14,"ar":"وَمَا هُوَ بِٱلۡهَزۡلِ","he":"ואין הוא הבל.","topics":"הקוראן והכתבים","story":null,"notes":null,"hadith":null},{"v":15,"ar":"إِنَّهُمۡ يَكِيدُونَ كَيۡدٗا","he":"הם זוממים מזימה,","topics":"הקוראן והכתבים","story":null,"notes":null,"hadith":null},{"v":16,"ar":"وَأَكِيدُ كَيۡدٗا","he":"ואני זומם מזימה.","topics":"הקוראן והכתבים","story":null,"notes":null,"hadith":null},{"v":17,"ar":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","he":"הארך אפוא לכופרים – הארך להם מעט.","topics":null,"story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}