{"n":114,"name":"الناس","verses":[{"v":1,"ar":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","he":"אמור: ״אני מבקש מחסה בריבון בני האדם,","topics":null,"story":null,"notes":["אל־מֻעַוִּד׳תַאן (113–114) – שתי סורות ההגנה; ריבון/מלך/אלוה – שלושה תוארים; השוו ״אלקינו מלכנו״."],"hadith":"16"},{"v":2,"ar":"مَلِكِ ٱلنَّاسِ","he":"מלך בני האדם,","topics":"תכונות האל ושמותיו","story":null,"notes":null,"hadith":null},{"v":3,"ar":"إِلَٰهِ ٱلنَّاسِ","he":"אלוה בני האדם,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","he":"מרעת הלוחש החומק,","topics":null,"story":null,"notes":["אל־וַסְוַאס אל־ח׳נַּאס – ״הלוחש החומק״: השטן, הנסוג כשהאדם זוכר את אללה; השוו ״יצר הרע״."],"hadith":null},{"v":5,"ar":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","he":"אשר לוחש בלבבות בני האדם,","topics":null,"story":null,"notes":null,"hadith":null},{"v":6,"ar":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","he":"מן הג׳ן ומן בני האדם.״","topics":"מלאכים, ג׳ין ושטן · גן העדן","story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}