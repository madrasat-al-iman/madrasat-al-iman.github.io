{"n":100,"name":"العاديات","verses":[{"v":1,"ar":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","he":"חי הדוהרים בנחירה,","topics":null,"story":null,"notes":["אל־עַאדִיַאת – הסוסים הדוהרים לקרב (או: גמלי העולים לרגל)."],"hadith":null},{"v":2,"ar":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","he":"והמעלים ניצוצות בהקשה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","he":"והפושטים עם בוקר,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","he":"ומעלים בו אבק,","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","he":"וחודרים בו אל לב ההמון –","topics":null,"story":null,"notes":null,"hadith":null},{"v":6,"ar":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","he":"האדם כפוי טובה לריבונו,","topics":null,"story":null,"notes":null,"hadith":null},{"v":7,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ","he":"והוא עצמו עד לכך,","topics":"משפט, עדות וצדק","story":null,"notes":null,"hadith":null},{"v":8,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلۡخَيۡرِ لَشَدِيدٌ","he":"ובאהבת הממון – עז הוא.","topics":null,"story":null,"notes":null,"hadith":null},{"v":9,"ar":"۞أَفَلَا يَعۡلَمُ إِذَا بُعۡثِرَ مَا فِي ٱلۡقُبُورِ","he":"הלא יידע – כאשר יופך מה שבקברים,","topics":null,"story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَحُصِّلَ مَا فِي ٱلصُّدُورِ","he":"ויוצא לאור מה שבלבבות –","topics":null,"story":null,"notes":null,"hadith":null},{"v":11,"ar":"إِنَّ رَبَّهُم بِهِمۡ يَوۡمَئِذٖ لَّخَبِيرُۢ","he":"שריבונם ביום ההוא בקיא בהם?","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}