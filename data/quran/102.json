{"n":102,"name":"التكاثر","verses":[{"v":1,"ar":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","he":"הסיחה את דעתכם ההתחרות בריבוי,","topics":null,"story":null,"notes":null,"hadith":null},{"v":2,"ar":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","he":"עד שביקרתם בבתי הקברות.","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"كَلَّا سَوۡفَ تَعۡلَمُونَ","he":"לא! עוד תדעו;","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","he":"ושוב – לא! עוד תדעו.","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","he":"לא! לו ידעתם ידיעת ודאות –","topics":"ידע, תבונה והתבוננות","story":null,"notes":["עִלְם אל־יַקִין / עַיְן אל־יַקִין – ״ידיעת ודאות / עין הוודאות״; בסופיות שלוש דרגות ודאות (ועוד חַקּ אל־יַקִין, 56:95)."],"hadith":null},{"v":6,"ar":"لَتَرَوُنَّ ٱلۡجَحِيمَ","he":"הייתם רואים את התופת;","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":7,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","he":"ואחר כך תראו אותה בעין הוודאות;","topics":null,"story":null,"notes":null,"hadith":null},{"v":8,"ar":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","he":"ואחר כך תישאלו ביום ההוא על הנעימות.","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":"3"}],"parallels":[],"bible":[]}