{"n":84,"name":"الإنشقاق","verses":[{"v":1,"ar":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","he":"כאשר השמיים ייבקעו,","topics":null,"story":null,"notes":null,"hadith":null},{"v":2,"ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","he":"ויישמעו לריבונם – וכך ראוי להם;","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","he":"וכאשר הארץ תימתח,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","he":"ותשליך את אשר בה ותתרוקן,","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":5,"ar":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","he":"ותישמע לריבונה – וכך ראוי לה –","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":6,"ar":"يَـٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحٗا فَمُلَٰقِيهِ","he":"הוי האדם, אתה עמל אל ריבונך עמל רב, ותפגוש אותו.","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":7,"ar":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","he":"אשר למי שיינתן לו ספרו בימינו –","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":"4"},{"v":8,"ar":"فَسَوۡفَ يُحَاسَبُ حِسَابٗا يَسِيرٗا","he":"ייעשה עמו חשבון קל,","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":"7"},{"v":9,"ar":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورٗا","he":"וישוב אל בני ביתו שמח;","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","he":"ואשר למי שיינתן לו ספרו מאחורי גבו –","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":11,"ar":"فَسَوۡفَ يَدۡعُواْ ثُبُورٗا","he":"יקרא לאבדון,","topics":null,"story":null,"notes":null,"hadith":null},{"v":12,"ar":"وَيَصۡلَىٰ سَعِيرًا","he":"ויישרף בתבערה.","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":13,"ar":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","he":"הוא היה בקרב בני ביתו שמח;","topics":null,"story":null,"notes":null,"hadith":null},{"v":14,"ar":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","he":"הוא סבר שלא ישוב.","topics":null,"story":null,"notes":null,"hadith":null},{"v":15,"ar":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرٗا","he":"אכן! ריבונו היה רואה אותו.","topics":null,"story":null,"notes":null,"hadith":null},{"v":16,"ar":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","he":"לא! נשבע אני בדמדומים,","topics":"שבועות, נדרים וקיום ברית","story":null,"notes":null,"hadith":null},{"v":17,"ar":"وَٱلَّيۡلِ وَمَا وَسَقَ","he":"ובלילה ובמה שהוא אוסף,","topics":null,"story":null,"notes":null,"hadith":null},{"v":18,"ar":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","he":"ובירח כאשר הוא מתמלא –","topics":null,"story":null,"notes":null,"hadith":null},{"v":19,"ar":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقٖ","he":"שתעלו שלב אחר שלב.","topics":null,"story":null,"notes":["טַבַקַן עַן טַבַק – ״שלב אחר שלב״: שלבי החיים, או מצב אחר מצב ביום הדין."],"hadith":"1"},{"v":20,"ar":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","he":"מה להם שאינם מאמינים,","topics":"הקוראן והכתבים · תפילה וזכירת האל","story":null,"notes":null,"hadith":null},{"v":21,"ar":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","he":"וכאשר נקרא לפניהם הקוראן – אינם משתחווים?","topics":"הקוראן והכתבים · תפילה וזכירת האל","story":null,"notes":null,"hadith":null},{"v":22,"ar":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","he":"אלא שאלה שכפרו מכחישים;","topics":"הקוראן והכתבים · תפילה וזכירת האל","story":null,"notes":null,"hadith":null},{"v":23,"ar":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","he":"ואללה יודע היטב את מה שהם אוצרים (בלבם).","topics":"הקוראן והכתבים · תפילה וזכירת האל","story":null,"notes":null,"hadith":null},{"v":24,"ar":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","he":"בשר להם אפוא עונש כואב,","topics":"הקוראן והכתבים · תפילה וזכירת האל","story":null,"notes":null,"hadith":null},{"v":25,"ar":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","he":"מלבד אלה שהאמינו ועשו את הטוב – להם שכר שאינו נפסק.","topics":null,"story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}