{"n":78,"name":"النبإ","verses":[{"v":1,"ar":"عَمَّ يَتَسَآءَلُونَ","he":"על מה שואלים זה את זה?","topics":null,"story":null,"notes":["עַמַּ – ״על מה״; הסורה נקראת אל־נַּבַּא׳ (הבשורה). ״הבשורה הגדולה״ – יום התחייה."],"hadith":null},{"v":2,"ar":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","he":"על הבשורה הגדולה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","he":"אשר בה הם חלוקים.","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"كَلَّا سَيَعۡلَمُونَ","he":"לא! עוד ידעו;","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":5,"ar":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","he":"ושוב – לא! עוד ידעו.","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":6,"ar":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدٗا","he":"הלא עשינו את הארץ ערש,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":7,"ar":"وَٱلۡجِبَالَ أَوۡتَادٗا","he":"ואת ההרים יתדות,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":8,"ar":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجٗا","he":"ובראנו אתכם זוגות,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":9,"ar":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتٗا","he":"ועשינו את שנתכם מנוחה,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":10,"ar":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسٗا","he":"ועשינו את הלילה לבוש,","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":11,"ar":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشٗا","he":"ועשינו את היום (זמן) מחיה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":12,"ar":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعٗا شِدَادٗا","he":"ובנינו מעליכם שבעה (רקיעים) איתנים,","topics":null,"story":null,"notes":null,"hadith":null},{"v":13,"ar":"وَجَعَلۡنَا سِرَاجٗا وَهَّاجٗا","he":"ושמנו נר בוהק,","topics":"גן העדן","story":null,"notes":null,"hadith":null},{"v":14,"ar":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءٗ ثَجَّاجٗا","he":"והורדנו מן העננים הסחוטים מים שוטפים,","topics":"גן העדן","story":null,"notes":null,"hadith":null},{"v":15,"ar":"لِّنُخۡرِجَ بِهِۦ حَبّٗا وَنَبَاتٗا","he":"כדי להוציא בהם גרעינים וצמחים,","topics":"גן העדן","story":null,"notes":null,"hadith":null},{"v":16,"ar":"وَجَنَّـٰتٍ أَلۡفَافًا","he":"וגנים סבוכים?","topics":"גן העדן","story":null,"notes":null,"hadith":null},{"v":17,"ar":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتٗا","he":"יום ההכרעה – מועד קבוע הוא:","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":18,"ar":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجٗا","he":"יום שבו יתקעו בשופר, ותבואו בקבוצות,","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null},{"v":19,"ar":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبٗا","he":"ונפתחו השמיים והיו שערים,","topics":null,"story":null,"notes":null,"hadith":null},{"v":20,"ar":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","he":"והוזזו ההרים והיו כמראה תעתוע (סַרַאבּ).","topics":"בריאה ואותות הטבע","story":null,"notes":null,"hadith":null},{"v":21,"ar":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادٗا","he":"הגיהינום – מארב היא,","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":22,"ar":"لِّلطَّـٰغِينَ مَـَٔابٗا","he":"לזדים – מקום שיבה,","topics":"גיהנום","story":null,"notes":null,"hadith":null},{"v":23,"ar":"لَّـٰبِثِينَ فِيهَآ أَحۡقَابٗا","he":"שוהים בה תקופות,","topics":null,"story":null,"notes":["אַחְקַאבּ – ״תקופות (ארוכות)״; מקור לוויכוח האם עונש הגיהינום סופי."],"hadith":null},{"v":24,"ar":"لَّا يَذُوقُونَ فِيهَا بَرۡدٗا وَلَا شَرَابًا","he":"לא יטעמו בה צינה ולא משקה,","topics":null,"story":null,"notes":null,"hadith":null},{"v":25,"ar":"إِلَّا حَمِيمٗا وَغَسَّاقٗا","he":"מלבד מים רותחים ומוגלה –","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":26,"ar":"جَزَآءٗ وِفَاقًا","he":"גמול הולם.","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":27,"ar":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابٗا","he":"הם לא קיוו לחשבון,","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":28,"ar":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابٗا","he":"והכחישו את אותותינו הכחשה;","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":29,"ar":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبٗا","he":"וכל דבר מנינו בכתב.","topics":"גמול, אחריות אישית ומאזני הדין","story":null,"notes":null,"hadith":null},{"v":30,"ar":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","he":"״טעמו אפוא – לא נוסיף לכם אלא עונש״.","topics":null,"story":null,"notes":null,"hadith":null},{"v":31,"ar":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","he":"ליראים – זכייה:","topics":null,"story":null,"notes":null,"hadith":null},{"v":32,"ar":"حَدَآئِقَ وَأَعۡنَٰبٗا","he":"גנים וכרמים,","topics":null,"story":null,"notes":null,"hadith":null},{"v":33,"ar":"وَكَوَاعِبَ أَتۡرَابٗا","he":"ועלמות בנות גיל אחד,","topics":null,"story":null,"notes":null,"hadith":null},{"v":34,"ar":"وَكَأۡسٗا دِهَاقٗا","he":"וגביע מלא;","topics":null,"story":null,"notes":null,"hadith":null},{"v":35,"ar":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوٗا وَلَا كِذَّـٰبٗا","he":"לא ישמעו בו הבל ולא שקר –","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":36,"ar":"جَزَآءٗ مِّن رَّبِّكَ عَطَآءً حِسَابٗا","he":"גמול מאת ריבונך, מתנה מחושבת (מספקת),","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":37,"ar":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابٗا","he":"ריבון השמיים והארץ ומה שביניהם, הרחמן; אין להם (רשות) לדבר אליו","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":null,"hadith":null},{"v":38,"ar":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَـٰٓئِكَةُ صَفّٗاۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابٗا","he":"ביום שבו יעמדו הרוח והמלאכים בשורה; לא ידברו, מלבד מי שהרחמן התיר לו, ואמר נכונה.","topics":"מלאכים, ג׳ין ושטן","story":null,"notes":["אל־רּוּח – ״הרוח״: ג׳בריל או מלאך גדול; השוו ״רוח הקודש״."],"hadith":null},{"v":39,"ar":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","he":"זה היום האמיתי; ומי שרוצה – ייקח לו מקום שיבה אל ריבונו.","topics":null,"story":null,"notes":null,"hadith":null},{"v":40,"ar":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابٗا قَرِيبٗا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","he":"הזהרנו אתכם מפני עונש קרוב – ביום שבו יראה האדם את מה שהקדימו ידיו, ויאמר הכופר: ״הלוואי שהייתי עפר!״","topics":"יום הדין ותחיית המתים","story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[]}