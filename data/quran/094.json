{"n":94,"name":"الشرح","verses":[{"v":1,"ar":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","he":"הלא הרחבנו לך את לבך,","topics":"הנביא מוחמד והקהילה בזמנו","story":null,"notes":null,"hadith":null},{"v":2,"ar":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","he":"והסרנו מעליך את משאך,","topics":null,"story":null,"notes":null,"hadith":null},{"v":3,"ar":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","he":"אשר הכביד על גבך,","topics":null,"story":null,"notes":null,"hadith":null},{"v":4,"ar":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","he":"והרמנו לך את שמך?","topics":null,"story":null,"notes":null,"hadith":null},{"v":5,"ar":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","he":"הנה עם הקושי – רווחה;","topics":null,"story":null,"notes":["״עם הקושי – רווחה״ פעמיים: לפי חדית׳ – ״קושי אחד לא יגבר על שתי רווחות״ (הקושי מיודע, הרווחה לא)."],"hadith":null},{"v":6,"ar":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرٗا","he":"הנה עם הקושי – רווחה.","topics":null,"story":null,"notes":null,"hadith":null},{"v":7,"ar":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","he":"וכאשר תסיים – עמול,","topics":null,"story":null,"notes":null,"hadith":null},{"v":8,"ar":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","he":"ואל ריבונך – כסוף.","topics":null,"story":null,"notes":null,"hadith":null}],"parallels":[],"bible":[{"a":7,"b":8,"ref":"בראשית מט, יח","route":"b/12/49:18","note":"״לישועתך קויתי ה׳״ – תפילה קצרה באמצע הברכות. בקוראן: ״וכאשר תתפנה – עמול, ואל ריבונך השתוקק״.","strength":"נושאית"}]}