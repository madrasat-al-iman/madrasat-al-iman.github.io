{"1":["אוי לשוקלים במאזני מרמה,","1"],"2":["המבקשים איפת צדק מאחרים,","2"],"3":["ומקטינים איפה בשקלם או במדדם לאחרים!","3"],"4":["הלא יתבוננו, כי יקומו מעפר.","4"],"5":["ביום הנורא,","5"],"6":["אשר בו יובאו בני האדם במשפט אל אדון העולמים?","6"],"7":["אמנם ספר מעללי הבוגדים הוא במקום הסגין;","7"],"8":["ומי יורך, מה הסגין?","8"],"9":["הוא ספר נודע.","9"],"10":["אוי ביום ההוא למכחשים באותותינו,","10"],"11":["ולועגים ליום הדין!","11"],"12":["אך לא יכחשו בהם כי אם אנשי עול.","12"],"13":["בהקרא אליהם אותותינו יאמרו: אך משלים קדמונים הם!","13"],"14":["מעלליהם הרעים גברו על לבם.","14"],"15":["ביום ההוא ירחקו מאת אדוניהם,","15"],"16":["ויצלו באש הגיהנם,","16"],"17":["ואלהים יאמר אליהם: הא לכם את אשר כחשתם בו!","17"],"18":["וספר מעללי הצדיקים יהיה בעליין.","18"],"19":["ומי יורך, מה העליין?","19"],"20":["הוא ספר נודע,","20"],"21":["אשר בו יעידו הקרובים לאל.","21"],"22":["הצדיקים יובלו אל גנות נעימים;","22"],"23":["על מטות שן ישבו וישאו את עיניהם;","23"],"24":["צהלה ורנה תראה על פניהם.","24"],"25":["יין זך וחתום ישתו.","25"],"26":["חותמו יהיה מסך, תאות נפש המאושרים.","26"],"27":["מהול יהיה במי התסנים,","27"],"28":["(מעין אשר ממנו ישתו הקרובים לאל).","28"],"29":["הבוגדים לועגים למאמינים;","29"],"30":["בפגעם בהם ידרשו להם לשלום;","30"],"31":["ובשובם אל בתיהם מתקלסים בהם.","31"],"32":["בראותם אותם, אומרים: אך תועים האנשים האלה!","32"],"33":["אמנם לא נתנום צופים להם.","33"],"34":["אכן ביום ההוא ילעגו המאמינים לבוגדים,","34"],"35":["בהביטם אליהם מערשותם.","35"],"36":["הלא ישולם לבוגדים כפי המעלליהם?","36"]}