{"1":["במלאכים השלוחים זה אחר זה,","1"],"2":["הקלים במרוצתם,","2"],"3":["ומפיצים את מצות אדונם,","3"],"4":["ומבדילים בין טוב לרע,","4"],"5":["ומביאים את זכרון אלהים אל בני האדם,","5"],"6":["לבשר טוב אל להזהיר;","6"],"7":["נשבעתי, כי יקום דבר אל אשר הועד בכם!","7"],"8":["ביום אסוף הכוכבים את נגהם,","8"],"9":["בהבקע השמיים,","9"],"10":["בהטחן ההרים,","10"],"11":["ובהעיד הנביאים;","11"],"12":["מי היום המועד לזאת?","12"],"13":["יום הפרידה","13"],"14":["ומי יודיעך את יום הפרידה?","14"],"15":["אוי ביום ההוא למכחשים באותותינו!","15"],"16":["הלא הצמתנו את הבוגדים הקדמונים?","16"],"17":["גם את הבוגדים, אשר אחריהם, נוליך בעקבותיהם.","17"],"18":["כן נעשה לחוטאים.","18"],"19":["אוי ביום ההוא למכחשים באותותינו!","19"],"20":["הלא בראנוכם מטיפה סרוחה,","20"],"21":["ונשימה אל מקום שאנן","21"],"22":["עד עת ידועה?","22"],"23":["יש לאל ידנו לעשות זאת.","23"],"24":["אוי ביום ההוא למכחשים באותותינו!","24"],"25":["הלא שמנו את הארץ למעון,","25"],"26":["לחיים ולמתים,","26"],"27":["ונשם בה הרים גבנונים וחזקים, ונשקכם מהם מים קרים?","27"],"28":["אוי ביום ההוא למכחשים באותותינו?","28"],"29":["אלהים יאמר אליהם: לכו אל הגיהנם, אשר כחשתם בו!","29"],"30":["לכו אל צל העשן העולה בשלושה עמודים!","30"],"31":["לא יועילכם הצל הזה, ולא יצילכם מלבת הגיהנם!","31"],"32":["הלהבה הזאת תשליך מקרבה ניצוצים גדולים כמגדלים,","32"],"33":["כגמלים צהובים.","33"],"34":["אוי ביום ההוא למכחשים באותותינו!","34"],"35":["לא יהיה להם פתחון פה,","35"],"36":["ולא יכסו את פשעיהם.","36"],"37":["אוי ביום ההוא למכחשים באותותינו!","37"],"38":["זה יום הפרידה, אשר בו נקבץ אתכם ואת הדורות הקדמונים.","38"],"39":["אם תוכלו להתחכם בנו, התחכמו!","39"],"40":["אוי ביום ההוא למכחשים באותותינו!","40"],"41":["אך יראי ד' ישבו בצללים על מעינות מים;","41"],"42":["שם ישיגו את אות נפשם;","42"],"43":["ואלהים יאמר אליהם: אכלו ושתו כאות נפשכם! זה פרי מעליליכם.","43"],"44":["כן ניתן שכר למישרי לכת","44"],"45":["אוי ביום ההוא למכחשים באותותינו!","45"],"46":["אתם הבוגדים! אכלו והתענגו עוד מעט!","46"],"47":["אוי ביום ההוא למכחשים באותותינו!","47"],"48":["בהאמר אליהם: כרעו! אינם כורעים.","48"],"49":["אוי ביום ההוא למכחשים באותותינו!","49"],"50":["באי זה זכרון אחר הקורן הזה תאמינו?","50"]}