{"1":["בהקרע השמים,","1"],"2":["לקול אדוניהם;","2"],"3":["בהרחב הארץ","3"],"4":["למען הריק את אשר בה","4"],"5":["ברצון אדונה,","5"],"6":["או תידע, בן האדם, לקרב ולשוב אל אדונך!","6"],"7":["לכל איש, אשר יושם ספרו ביד ימינו,","7"],"8":["יקל משפטו וחשבונו,","8"],"9":["וישוב בלב שמח אל משפחתו;","9"],"10":["וכל איש אשר יושם ספרו אחרי גיוו,","10"],"11":["יבקש להיות לאפס;","11"],"12":["אמנם יצלה באש הגיהנם","12"],"13":["על הרימו את לבו בקרב משפחתו,","13"],"14":["ועל דמותו בנפשו כי לא ישוב אל אלהים;","14"],"15":["אמנם אדוניו הביט אל מעלליו.","15"],"16":["נשבעתי בנודה הערב,","16"],"17":["בלילה ובאשר יאסף,","17"],"18":["בירח בהמלאו,","18"],"19":["כי תצאו מחיל אל חיל.","19"],"20":["מה להם כי לטא יאמינו?","20"],"21":["הלא ישתחוו בהקרא אליהם הקוראן?","21"],"22":["הבוגדים מכחשים בו,","22"],"23":["אך אלהים יודע את חדרי להם.","23"],"24":["בשר אותם עונש גדול!","24"],"25":["אך למאמינים ולעושי טוב לא יגרע שכרם.","25"]}