{"1":["בלילה בכסותו,","1"],"2":["ביום בהאירו,","2"],"3":["בבורא את הזכר ואת הנקבה,","3"],"4":["נשבעתי, כי דעותיכם נפרדות.","4"],"5":["לכל השומע לקול אלהים וירא אותו,","5"],"6":["","5"],"7":["והולך בדרך הטובה, נישר את דרכו;","6–7"],"8":["ולכל חכילי ורודף אחרי ההון,","8"],"9":["ומכחש באמונה הטובה,","9"],"10":["נכין את צעדו לרעתו,","10"],"11":["ולא יועילנו עשרו בהושלכו אל אש הגיהנם,","11"],"12":["עלינו להנחות את בני האדם;","12"],"13":["לנו העולם הזה והעולם הבא;","13"],"14":["לכן הזהרתיכם על האד הקודחת,","14"],"15":["אשר בה הבוגדים יצלו,","15"],"16":["המכחשים בנו וסרים מאחרינו.","16"],"17":["אך הצדיק ינצל ממנה,","17"],"18":["המפזר מהונו למען נקות את נפשו,","18"],"19":["ולא יבקש שכר בעד הטובה אשר גמל,","19"],"20":["כי אם נכספה נפשו לראות את פני אדונך העליון;","20"],"21":["ובאחריתו אלהים ירצהו.","21"]}