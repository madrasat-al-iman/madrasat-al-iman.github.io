{"1":["נשבעתי בשמים ובכוכב הליל,","1"],"2":["(ומי יורך, מה כוכב הליל?","2"],"3":["הוא כוכב מפיק אור גדול.)","3"],"4":["כי לכל נפש יש צופה.","4"],"5":["לכן יתבונן כל אדם, מאין נברא:","5"],"6":["ממים שפוכים,","6"],"7":["היוצאים מהחלצים ומעצם השדים.","7"],"8":["אכן יש עוז לאלהים להשיבכם אליו,","8"],"9":["ביום היגלות הנסתרות;","9"],"10":["ואין לכם עוזר ומושיע מבלעדיו.","10"],"11":["בשמים השבים במרוצתם,","11"],"12":["ובארץ הפוצה את פיה,","12"],"13":["נשבעתי, כי הוא דבר מבחין,","13"],"14":["ואין בו דברי ריק.","14"],"15":["הם מתנכלים בו,","15"],"16":["אך אני אתחכם להם;","16"],"17":["לכן שא את דברי הבוגדים; עוד מעט יתענגו!","17"]}