{"1":["הלא הגיעתך שמועת המכסה?","1"],"2":["יש אנשים, אשר מראיהם ישחרו ביום ההוא;","2"],"3":["ייעפו וייגעו,","3"],"4":["ויצלו באש הגיהנם.","4"],"5":["יושקו ממעין חם,","5"],"6":["וקוצים יהיו להם למזון,","6"],"7":["אשר לא ישמינום ולא ירוו את נפשם.","7"],"8":["ויש אנשים אשר פניהם ילבשו צהלה,","8"],"9":["ויגילו על צדקתם.","9"],"10":["בגנות העליונים;","10"],"11":["לא ישמעו שם דברי ריק;","11"],"12":["שם ימצאו מעין נובע,","12"],"13":["ומטות נחמדות,","13"],"14":["ודביעים מלאים,","14"],"15":["וערשות מרווחים,","15"],"16":["ויריעות פרושות.","15"],"17":["הלא יביטו בני האדם אל העבים המלאים גשם,","17"],"18":["ואל השמים הנשגבים,","18"],"19":["ואל ההרים הנכונים,","19"],"20":["ואל הארץ השטוחה?","20"],"21":["הזהירם, כי מזהיר אתה;","21"],"22":["אך אין לך שלטון בהם!","22"],"23":["וכל הפונה אליך עורף ובוגד בך","23"],"24":["ייסרהו אלהים בעונש גדול.","24"],"25":["אלינו ישובו,","25"],"26":["ועלינו לחשב אתם.","26"]}